{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/abicheck/integration-lab/ci/schemas/build-output.schema.json",
  "title": "ABICheck standardized build output",
  "type": "object",
  "required": ["schema", "project", "head_sha", "source_tree_digest", "profile", "targets", "digests", "diagnostics"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "abicheck.build-output/v1"},
    "project": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "minLength": 1},
    "source_tree_digest": {"type": "string", "minLength": 1},
    "profile": {
      "type": "object",
      "required": ["id", "os", "arch", "compiler"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "os": {"type": "string"},
        "arch": {"type": "string"},
        "compiler": {
          "type": "object",
          "required": ["family", "version"],
          "properties": {"family": {"type": "string"}, "version": {"type": "string"}}
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "binary", "public_header_roots"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "binary": {"type": "string", "minLength": 1},
          "public_header_roots": {"type": "array", "items": {"type": "string"}},
          "generated_header_roots": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "object"}
        }
      }
    },
    "digests": {"type": "object", "additionalProperties": {"type": "string"}},
    "diagnostics": {"type": "object"}
  }
}
