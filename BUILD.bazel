load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

cc_library(
    name = "core_api",
    hdrs = ["core_include/abicheck_lab/core.h"],
    includes = ["core_include"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "core_internal_api",
    hdrs = ["internal/include/abicheck_lab/core_c_api.h"],
    includes = ["internal/include"],
    visibility = [
        "//:__pkg__",
        "//strings_lib:__pkg__",
    ],
)

cc_library(
    name = "core_impl",
    srcs = ["src/core.cc"],
    deps = [":core_api", ":core_internal_api"],
    visibility = ["//visibility:private"],
)

cc_shared_library(
    name = "core",
    shared_lib_name = "libcore.so",
    deps = [":core_impl"],
    user_link_flags = ["-Wl,-soname,libcore.so"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "math_api",
    hdrs = ["include/abicheck_lab/math.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)

# Legacy/demo target shape (capabilities.yaml: target_shape = cc_binary_linkshared)
# -- this is what every existing scan/scenario/toolchain-matrix job in this
# repo still builds and scans. Kept unchanged and still the ONE target the
# required PR gate (abi-scan.yml's `scan` job) exercises: a target-shape
# migration is out of scope for a capability-matrix PR on its own, and every
# existing job's cache key, evidence pack, and committed baseline
# (abi/math.abicheck.json) are keyed to `//:math` specifically.
#
# linkopts sets an explicit SONAME (equal to this target's own output
# filename, libmath.so -- no version suffix, so no extra versioned-symlink
# companion file is needed alongside it): a real shared library should
# carry a SONAME for correct dynamic-linker identity (this is a demo/lab
# target, but there's no reason for it to skip a real-world practice on
# top of that). Without this, `cc_binary(linkshared = True)` embeds no
# SONAME at all -- the gap cross_build_equivalence
# (ci/compare_build_outputs.py) originally found between all three build
# systems (buildsystems/cmake/CMakeLists.txt, buildsystems/make/Makefile
# -- both now set the identical libmath.so/libstrings.so SONAME the same
# way).
cc_binary(
    name = "math",
    srcs = ["src/math.cc"],
    deps = [":math_api"],
    linkshared = True,
    linkopts = ["-Wl,-soname,libmath.so"],
    visibility = ["//visibility:public"],
)

# The project variant owns the core provider edge. Keeping it separate from
# //:math preserves the scope contract of the long-lived committed baseline.
cc_binary(
    name = "project_math",
    srcs = ["src/math.cc"],
    copts = ["-O2"],
    deps = [":math_api"],
    dynamic_deps = [":core"],
    linkshared = True,
    linkopts = [
        "-Wl,--no-as-needed,-u,abicheck_lab_core_scale",
        "-Wl,-soname,libmath.so",
    ],
    visibility = ["//visibility:public"],
)

# Realistic target shape (capabilities.yaml: target_shape = cc_shared_library)
# -- the shape a real Bazel C++ project actually uses for a shared library
# with library-vs-library dependencies, as opposed to `math`'s
# cc_binary(linkshared=True) demo shape above. `math_impl` is a private,
# ordinary cc_library (never linked on its own); `cc_shared_library` is what
# actually produces the .so, giving this lab a second, independently-scanned
# target whose Bazel action graph (link action, exports, output naming, root
# target identity) genuinely differs from `math`'s -- see capabilities.yaml's
# cc-shared-library-target-shape entry (README's own review: "no true
# cc_shared_library, no MODULE.bazel.lock" was the reason this axis was a
# gap). Deliberately non-gating everywhere it's wired into CI so far (no
# existing job's cache key, evidence pack, or committed baseline is keyed to
# it) -- see abi-scan.yml's `scan_math_shared` job.
cc_library(
    name = "math_impl",
    srcs = ["src/math.cc"],
    deps = [":math_api"],
    visibility = ["//visibility:private"],
)

cc_shared_library(
    name = "math_shared",
    shared_lib_name = "libmath_shared.so",
    deps = [":math_impl"],
    visibility = ["//visibility:public"],
)
