load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# A second, independent library (architecture review P1-5). Deliberately
# its own Bazel package, not folded into the root BUILD.bazel alongside
# :math/:math_api -- see strings.h's own comment for why.
cc_library(
    name = "strings_api",
    hdrs = ["include/abicheck_lab/strings.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)

# linkopts sets an explicit SONAME (equal to this target's own output
# filename) -- same reasoning as //:math's own identical linkopts (see
# BUILD.bazel's own comment).
cc_binary(
    name = "strings",
    srcs = ["src/strings.cc"],
    deps = [":strings_api"],
    linkshared = True,
    linkopts = ["-Wl,-soname,libstrings.so"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "project_strings",
    srcs = ["src/strings.cc"],
    copts = ["-O2"],
    deps = [":strings_api"],
    dynamic_deps = ["//:core"],
    linkshared = True,
    linkopts = [
        "-Wl,--no-as-needed,-u,abicheck_lab_core_scale",
        "-Wl,-soname,libstrings.so",
    ],
    visibility = ["//visibility:public"],
)
