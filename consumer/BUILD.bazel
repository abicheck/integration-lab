load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")

# Wraps //:math's own shared-library output so consumer_app below can link
# against it dynamically, the same way a real downstream application would
# consume a prebuilt libmath.so rather than recompiling math.cc itself.
cc_import(
    name = "math_shared",
    shared_library = "//:math",
    visibility = ["//visibility:private"],
)

# Architecture review P1-6 (consumer/app-scoped validation): a real
# application binary that links dynamically against //:math and calls only
# a subset of its public API (Calculator::add -- never ::multiply or
# api_version). See app.cc's own comment for why this shape matters:
# `abicheck compare --used-by` reads THIS binary's actual dynamic-symbol
# imports to scope the comparison, so a change to a function this consumer
# never calls (::multiply) is demoted to informational context while a
# change to one it does call (::add) still gates -- proven against a real
# compiled+linked consumer, not a hand-written import list.
cc_binary(
    name = "consumer_app",
    srcs = ["app.cc"],
    deps = [
        "//:math_api",
        ":math_shared",
    ],
)
